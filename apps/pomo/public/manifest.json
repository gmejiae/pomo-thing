        "max": 120,
        "step": 1,
        "default": 25
      }
    },
    {
      "type": "number",
      "data": {
        "key": "short",
        "label": "Descanso corto preset 1 / Preset 1 short break (min)",
        "min": 1,
        "max": 60,
        "step": 1,
        "default": 5
      }
    },
    {
      "type": "number",
      "data": {
        "key": "long",
        "label": "Descanso largo / Long break (min)",
        "min": 1,
        "max": 60,
        "step": 1,
        "default": 15
      }
    },
    {
      "type": "number",
      "data": {
        "key": "every",
        "label": "Descanso largo cada N / Long break every N",
        "min": 1,
        "max": 12,
        "step": 1,
        "default": 4
      }
    },
    {
      "type": "number",
      "data": {
