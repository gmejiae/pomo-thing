      "data": {
        "key": "sound",
        "label": "Sonido del aviso / Alert sound",
        "choices": [
          "Glass",
          "Ping",
          "Hero",
          "Purr",
          "Submarine",
          "Funk",
          "Pop",
          "Tink",
          "Ninguno / None"
        ],
        "default": "Glass"
      }
    }
  ],
  "permissions": [],
  "art": {
    "heroPx": 248,
    "thumbPx": 96
  },
  "extension": {
    "entry": "extension/desktop.mjs",
